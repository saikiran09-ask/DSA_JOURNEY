import java.util.*;

public class Main{
  public static void main(String[] args){
    //write your logic or code here
    Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();
    if(n==0){
      System.out.println(0);
    }
    if(n==1){
      System.out.println(1);
    }
    int a=0,b=1;
    System.out.print(a+" "+b+" ");
    for(int i=2;i<n;i++){
     int c = a+b;
    System.out.print(c+" ");
     a=b;
     b=c;
    }
  }
}

class Solution {
    public int fib(int n) {
        if(n==0){
            return 0;
        }
        if(n==1){
            return 1;
        }
        int a=0,b=1;
        int c=0;
        for(int i=2;i<=n;i++){
             c = a+b;
            a=b;
            b=c;
        }
        return c;
    }
}
